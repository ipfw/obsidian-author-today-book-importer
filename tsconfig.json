{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "declaration": false,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "rootDir": "src",
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "dist",
    "types": ["node", "obsidian"],
    "skipLibCheck": true
  },
  "include": ["src"]
}
